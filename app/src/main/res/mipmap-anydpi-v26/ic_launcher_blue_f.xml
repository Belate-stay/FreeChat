<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/transparent" />
    <foreground>
        <!-- Adaptive layers are 150% of the viewport. This 1/6 compensation restores
             the supplied complete image to 100%, with no added border or new artwork. -->
        <inset android:inset="16.666667%">
            <bitmap android:src="@drawable/freechat_icon_blue_f" android:gravity="fill" />
        </inset>
    </foreground>
</adaptive-icon>
